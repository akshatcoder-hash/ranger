{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ranger",
  "main": "./deploy/cloudflare/index.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "account_id": "7fc8a64ca2b1e078e8b415687b7fb854",
  "routes": [
    {
      "pattern": "ranger.akshats.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1", "/v1/*"]
  },
  "vars": {
    "BACKEND_ORIGIN": "https://ranger-backend-akshats.fly.dev",
    "PUBLIC_ORIGIN": "https://ranger.akshats.xyz"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true
  }
}

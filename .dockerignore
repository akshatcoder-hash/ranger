# Build context is the Ranger backend root plus the staged Trace bundle.
# Deny first, then re-include only what the image build needs.
*

!package.json
!package-lock.json
!.npmrc
!tsconfig.json
!tsconfig.build.json
!src/
!src/**
!scripts/
!scripts/**
!migrations/
!migrations/**
!contracts/
!contracts/**
!config/
!config/**
!deploy/
!deploy/**
!.fly-build/
!.fly-build/trace.bundle

# Never ship host state, even if a parent directory was re-included.
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.crt
**/data
**/data/**
**/.scratch
**/.scratch/**
**/frontend
**/frontend/**
**/docs
**/docs/**
**/tests
**/tests/**
**/coverage
**/coverage/**
**/.trace-home
**/.trace-home/**
**/*.db
**/*.db-wal
**/*.db-shm
**/.DS_Store
**/*.log

{
  "schemaVersion": 1,
  "eventTypes": [
    {
      "name": "retrieval.search.completed",
      "description": "Actual server-side retrieval duration, including queueing, runtime startup and citation verification; no query or source content",
      "dataSchema": {
        "type": "object",
        "required": [
          "provider",
          "durationMs",
          "resultCount"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "trace",
              "file-search-fallback"
            ]
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "resultCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "project.updated",
      "description": "Project or engineer display name changed",
      "dataSchema": {
        "type": "object",
        "required": [
          "name",
          "engineerDisplayName"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 300
          },
          "engineerDisplayName": {
            "type": "string",
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "membership.updated",
      "description": "Project membership added, changed or removed (role null on removal)",
      "dataSchema": {
        "type": "object",
        "required": [
          "principalId",
          "role"
        ],
        "properties": {
          "principalId": {
            "type": "string",
            "pattern": "^prin_[0-9a-fA-F-]+$",
            "description": "Prefixed prin identifier"
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "owner",
                  "member"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "repository.connected",
      "description": "Repository reference connected or replaced",
      "dataSchema": {
        "type": "object",
        "required": [
          "url",
          "ref",
          "commit",
          "checkoutPath"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "ref": {
            "type": "string",
            "maxLength": 256
          },
          "commit": {
            "type": "string"
          },
          "checkoutPath": {
            "type": "string",
            "maxLength": 512
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "repository.disconnected",
      "description": "Repository reference disconnected (recorded atomically with the removal)",
      "dataSchema": {
        "type": "object",
        "required": [
          "url",
          "ref",
          "commit",
          "checkoutPath"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "ref": {
            "type": "string",
            "maxLength": 256
          },
          "commit": {
            "type": "string"
          },
          "checkoutPath": {
            "type": "string",
            "maxLength": 512
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "conversation.created",
      "description": "Conversation created",
      "dataSchema": {
        "type": "object",
        "required": [
          "conversationId",
          "title"
        ],
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^cnv_[0-9a-fA-F-]+$",
            "description": "Prefixed cnv identifier"
          },
          "title": {
            "type": "string",
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "conversation.message.created",
      "description": "Message appended to a conversation",
      "dataSchema": {
        "type": "object",
        "required": [
          "conversationId",
          "messageId",
          "role"
        ],
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^cnv_[0-9a-fA-F-]+$",
            "description": "Prefixed cnv identifier"
          },
          "messageId": {
            "type": "string",
            "pattern": "^msg_[0-9a-fA-F-]+$",
            "description": "Prefixed msg identifier"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "agent",
              "system"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "conversation.question.created",
      "description": "Clarification question created",
      "dataSchema": {
        "type": "object",
        "required": [
          "conversationId",
          "questionId",
          "prompt"
        ],
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^cnv_[0-9a-fA-F-]+$",
            "description": "Prefixed cnv identifier"
          },
          "questionId": {
            "type": "string",
            "pattern": "^qst_[0-9a-fA-F-]+$",
            "description": "Prefixed qst identifier"
          },
          "prompt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "conversation.answer.created",
      "description": "Answer recorded against a question",
      "dataSchema": {
        "type": "object",
        "required": [
          "conversationId",
          "questionId",
          "answerId"
        ],
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^cnv_[0-9a-fA-F-]+$",
            "description": "Prefixed cnv identifier"
          },
          "questionId": {
            "type": "string",
            "pattern": "^qst_[0-9a-fA-F-]+$",
            "description": "Prefixed qst identifier"
          },
          "answerId": {
            "type": "string",
            "pattern": "^ans_[0-9a-fA-F-]+$",
            "description": "Prefixed ans identifier"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "requirement.version.created",
      "description": "New immutable requirement version",
      "dataSchema": {
        "type": "object",
        "required": [
          "requirementId",
          "version"
        ],
        "properties": {
          "requirementId": {
            "type": "string",
            "pattern": "^rqm_[0-9a-fA-F-]+$",
            "description": "Prefixed rqm identifier"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "decision.version.created",
      "description": "New immutable decision version",
      "dataSchema": {
        "type": "object",
        "required": [
          "decisionId",
          "version"
        ],
        "properties": {
          "decisionId": {
            "type": "string",
            "pattern": "^dcs_[0-9a-fA-F-]+$",
            "description": "Prefixed dcs identifier"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "plan.version.created",
      "description": "New plan version generated (names impacted files/tests and invalidated approvals on a revision)",
      "dataSchema": {
        "type": "object",
        "required": [
          "planId",
          "version"
        ],
        "properties": {
          "planId": {
            "type": "string",
            "pattern": "^pln_[0-9a-fA-F-]+$",
            "description": "Prefixed pln identifier"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "invalidatedApprovalIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impactedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impactedTests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "plan.draft.failed",
      "description": "Plan draft attempt failed before a version was saved (carries only a diagnostic class)",
      "dataSchema": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "plan.approval.granted",
      "description": "Exact plan version approved with the permitted sandbox scope",
      "dataSchema": {
        "type": "object",
        "required": [
          "approvalId",
          "planId",
          "version"
        ],
        "properties": {
          "approvalId": {
            "type": "string",
            "pattern": "^apr_[0-9a-fA-F-]+$",
            "description": "Prefixed apr identifier"
          },
          "planId": {
            "type": "string",
            "pattern": "^pln_[0-9a-fA-F-]+$",
            "description": "Prefixed pln identifier"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "permittedScope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approvedBy": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "plan.approval.invalidated",
      "description": "Approval invalidated by a material requirement change; names impacted files and tests",
      "dataSchema": {
        "type": "object",
        "required": [
          "approvalId",
          "planId",
          "version",
          "reason"
        ],
        "properties": {
          "approvalId": {
            "type": "string",
            "pattern": "^apr_[0-9a-fA-F-]+$",
            "description": "Prefixed apr identifier"
          },
          "planId": {
            "type": "string",
            "pattern": "^pln_[0-9a-fA-F-]+$",
            "description": "Prefixed pln identifier"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          },
          "impactedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impactedTests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "run.state.changed",
      "description": "Run state transition (queued/running then terminal; pause/resume do not exist)",
      "dataSchema": {
        "type": "object",
        "required": [
          "runId",
          "from",
          "to"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "description": "Run identifier"
          },
          "from": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "queued",
                  "running",
                  "succeeded",
                  "failed",
                  "cancelled"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "run.tool.progress",
      "description": "Durable tool/step progress within a run (bounded; full results stay in run records)",
      "dataSchema": {
        "type": "object",
        "required": [
          "runId",
          "callId",
          "tool",
          "status"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "description": "Run identifier"
          },
          "callId": {
            "type": "string",
            "maxLength": 128
          },
          "tool": {
            "type": "string",
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "denied",
              "error"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "run.scope.violation",
      "description": "Action outside approved scope (or after invalidation) was blocked by the tool layer",
      "dataSchema": {
        "type": "object",
        "required": [
          "runId",
          "tool",
          "reason"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "description": "Run identifier"
          },
          "tool": {
            "type": "string",
            "maxLength": 64
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "capture.session.started",
      "description": "Screen capture session started",
      "dataSchema": {
        "type": "object",
        "required": [
          "sessionId"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^cap_[0-9a-fA-F-]+$",
            "description": "Prefixed cap identifier"
          },
          "conversationId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^cnv_[0-9a-fA-F-]+$",
                "description": "Prefixed cnv identifier"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "capture.session.ended",
      "description": "Screen capture session ended; the generation advanced, invalidating late results",
      "dataSchema": {
        "type": "object",
        "required": [
          "sessionId",
          "generation",
          "reason"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^cap_[0-9a-fA-F-]+$",
            "description": "Prefixed cap identifier"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "maxLength": 120
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "capture.frame.ingested",
      "description": "Validated frame accepted as the current latest frame (metadata only, never bytes)",
      "dataSchema": {
        "type": "object",
        "required": [
          "sessionId",
          "generation",
          "frameId",
          "byteSize",
          "width",
          "height",
          "captureTimestamp",
          "replacedFrameId"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^cap_[0-9a-fA-F-]+$",
            "description": "Prefixed cap identifier"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "frameId": {
            "type": "string",
            "maxLength": 200
          },
          "byteSize": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "captureTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "replacedFrameId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "capture.frame.dropped",
      "description": "Frame dropped by a bound (names the affected frameId and reason)",
      "dataSchema": {
        "type": "object",
        "required": [
          "sessionId",
          "frameId",
          "reason"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^cap_[0-9a-fA-F-]+$",
            "description": "Prefixed cap identifier"
          },
          "frameId": {
            "type": "string",
            "maxLength": 200
          },
          "reason": {
            "type": "string",
            "maxLength": 64
          },
          "currentFrameId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "capture.frame.deduplicated",
      "description": "Near-identical frame suppressed (optional exact-duplicate suppression detail)",
      "dataSchema": {
        "type": "object"
      }
    },
    {
      "name": "capture.inspection.completed",
      "description": "Structured inspection observation recorded against the validated source frame",
      "dataSchema": {
        "type": "object",
        "required": [
          "sessionId",
          "frameId",
          "observationCount"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^cap_[0-9a-fA-F-]+$",
            "description": "Prefixed cap identifier"
          },
          "frameId": {
            "type": "string",
            "maxLength": 200
          },
          "observationCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "capture.inspection.rejected-stale",
      "description": "A late or superseded inspection result was rejected and discarded",
      "dataSchema": {
        "type": "object",
        "required": [
          "sessionId",
          "frameId",
          "reason"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^cap_[0-9a-fA-F-]+$",
            "description": "Prefixed cap identifier"
          },
          "frameId": {
            "type": "string",
            "maxLength": 200
          },
          "reason": {
            "type": "string",
            "enum": [
              "capture_ended",
              "superseded_frame"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "voice.session.started",
      "description": "Voice session started (pinned provider model, explicit lifetime)",
      "dataSchema": {
        "type": "object",
        "required": [
          "sessionId",
          "conversationId",
          "model"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^vcs_[0-9a-fA-F-]+$",
            "description": "Prefixed vcs identifier"
          },
          "conversationId": {
            "type": "string",
            "pattern": "^cnv_[0-9a-fA-F-]+$",
            "description": "Prefixed cnv identifier"
          },
          "model": {
            "type": "string",
            "maxLength": 120
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "voice.session.ended",
      "description": "Voice session ended (terminal and idempotent; reconnect creates a NEW session)",
      "dataSchema": {
        "type": "object",
        "required": [
          "sessionId",
          "conversationId",
          "reason"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^vcs_[0-9a-fA-F-]+$",
            "description": "Prefixed vcs identifier"
          },
          "conversationId": {
            "type": "string",
            "pattern": "^cnv_[0-9a-fA-F-]+$",
            "description": "Prefixed cnv identifier"
          },
          "reason": {
            "type": "string",
            "maxLength": 120
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "voice.response.cancelled",
      "description": "In-flight voice response cancelled and flushed (voice output only, never a run)",
      "dataSchema": {
        "type": "object",
        "required": [
          "sessionId"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^vcs_[0-9a-fA-F-]+$",
            "description": "Prefixed vcs identifier"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "voice.usage.recorded",
      "description": "Observed provider usage recorded for a session",
      "dataSchema": {
        "type": "object",
        "required": [
          "sessionId",
          "audioSeconds",
          "textTokens",
          "toolCalls"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^vcs_[0-9a-fA-F-]+$",
            "description": "Prefixed vcs identifier"
          },
          "audioSeconds": {
            "type": "number",
            "minimum": 0
          },
          "textTokens": {
            "type": "integer",
            "minimum": 0
          },
          "toolCalls": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "workspace.preparation.updated",
      "description": "Voice-requested project workspace preparation progress (read-only sandbox + code index); the latest event is the durable preparation status",
      "dataSchema": {
        "type": "object",
        "required": [
          "jobId",
          "phase"
        ],
        "properties": {
          "jobId": {
            "type": "string",
            "maxLength": 128
          },
          "phase": {
            "type": "string",
            "enum": [
              "queued",
              "preparing",
              "indexing",
              "ready",
              "failed"
            ]
          },
          "fileCount": {
            "type": "integer",
            "minimum": 0
          },
          "byteCount": {
            "type": "integer",
            "minimum": 0
          },
          "indexElapsedMs": {
            "type": "integer",
            "minimum": 0
          },
          "elapsedMs": {
            "type": "integer",
            "minimum": 0
          },
          "errorCode": {
            "type": "string",
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "maxLength": 400
          },
          "repositoryCommit": {
            "type": "string",
            "maxLength": 64
          },
          "cloneElapsedMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "workspace.command.started",
      "description": "Supervised command started in the project VM",
      "dataSchema": {
        "type": "object",
        "required": [
          "commandId",
          "command",
          "state",
          "exitCode",
          "timedOut"
        ],
        "properties": {
          "commandId": {
            "type": "string",
            "pattern": "^cmd_[0-9a-fA-F-]+$",
            "description": "Prefixed cmd identifier"
          },
          "command": {
            "type": "string",
            "maxLength": 4000
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "failed",
              "terminated"
            ]
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "timedOut": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "workspace.command.finished",
      "description": "Supervised command finished with real exit status",
      "dataSchema": {
        "type": "object",
        "required": [
          "commandId",
          "command",
          "state",
          "exitCode",
          "timedOut"
        ],
        "properties": {
          "commandId": {
            "type": "string",
            "pattern": "^cmd_[0-9a-fA-F-]+$",
            "description": "Prefixed cmd identifier"
          },
          "command": {
            "type": "string",
            "maxLength": 4000
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "failed",
              "terminated"
            ]
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
